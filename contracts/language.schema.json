{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OraCool/email-thread-mcp/contracts/language.schema.json",
  "title": "check_language result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "language_status",
    "language_ok",
    "language_expected",
    "language_checked",
    "language_issues",
    "language_undecided"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "language_status": {
      "enum": [
        "ok",
        "drift",
        "undecided"
      ],
      "description": "drift when any text drifted; else undecided when any text is undecided; else ok."
    },
    "language_ok": {
      "type": "boolean",
      "description": "language_status == ok."
    },
    "language_expected": {
      "type": "string",
      "description": "The requested code, normalised (lowercase; nb -> no)."
    },
    "language_checked": {
      "type": "integer",
      "minimum": 0,
      "description": "Texts long enough to judge."
    },
    "language_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "expected",
          "detected",
          "confidence",
          "text"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "description": "Position of the text in the input list."
          },
          "expected": {
            "type": "string"
          },
          "detected": {
            "type": "string",
            "description": "The detector's top guess (py3langid code)."
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Probability that the text is NOT in the expected language or a close variant of it."
          },
          "text": {
            "type": "string",
            "maxLength": 300,
            "description": "The start of the text."
          }
        }
      },
      "description": "Texts confidently in another language."
    },
    "language_undecided": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "expected",
          "detected",
          "confidence",
          "text"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "description": "Position of the text in the input list."
          },
          "expected": {
            "type": "string"
          },
          "detected": {
            "type": "string",
            "description": "The detector's top guess (py3langid code)."
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Probability that the text is NOT in the expected language or a close variant of it."
          },
          "text": {
            "type": "string",
            "maxLength": 300,
            "description": "The start of the text."
          }
        }
      },
      "description": "Texts the detector cannot settle; decide them another way."
    }
  }
}
